# Test Environment Variables

# Application URLs
TEST_BASE_URL=http://localhost:5000

# Test Users
TEST_ADMIN_USER=admin
TEST_ADMIN_PASSWORD=admin123
TEST_ADMIN_EMAIL=admin@example.com

TEST_DISPATCHER_USER=dispatcher
TEST_DISPATCHER_PASSWORD=dispatch123
TEST_DISPATCHER_EMAIL=dispatch@example.com

TEST_RESPONDER_USER=responder
TEST_RESPONDER_PASSWORD=respond123
TEST_RESPONDER_EMAIL=responder@example.com

# Selenium Configuration
SELENIUM_BROWSER=chrome
SELENIUM_HEADLESS=true
SELENIUM_WINDOW_SIZE=1920,1080
SELENIUM_IMPLICIT_WAIT=10
SELENIUM_PAGE_LOAD_TIMEOUT=30
SELENIUM_SCRIPT_TIMEOUT=30
SCREENSHOTS_ON_FAILURE=true

# API Configuration
API_TIMEOUT=30
API_MAX_RETRIES=3
API_RETRY_DELAY=1

# Database Configuration
TEST_DATABASE_URL=sqlite:///test_cad_system.db
SQL_ECHO=false
